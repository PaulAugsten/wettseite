{
    "name": "wettsite",
    "version": "1.1.0",
    "private": true,
    "scripts": {
        "analyze": "ANALYZE=true next build",
        "build": "next build",
        "dev": "next dev",
        "doctor": "npx react-doctor@latest",
        "format": "biome format --write .",
        "knip": "knip",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "lint:next": "eslint",
        "postinstall": "node scripts/postinstall-precommit.mjs",
        "release:dry-run": "semantic-release --dry-run --no-ci",
        "scrape:matches": "tsx scripts/scrape-matches.ts",
        "scrape:tournaments": "tsx scripts/scrape-tournaments.ts",
        "size": "size-limit",
        "start": "next start",
        "test": "vitest run --passWithNoTests",
        "test:coverage": "vitest run --coverage --passWithNoTests",
        "test:e2e": "playwright test",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@ducanh2912/next-pwa": "^10.2.9",
        "@sentry/nextjs": "^10.76.2",
        "@supabase/ssr": "^0.12.7",
        "@supabase/supabase-js": "^2.118.0",
        "@vercel/analytics": "^2.0.1",
        "@vercel/speed-insights": "^2.0.0",
        "babel-plugin-react-compiler": "^1.0.0",
        "cheerio": "^1.2.0",
        "next": "^16.2.10",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@biomejs/biome": "^2.5.15",
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@next/bundle-analyzer": "^16.2.10",
        "@playwright/test": "^1.61.0",
        "@semantic-release/changelog": "^6.0.3",
        "@semantic-release/git": "^11.0.1",
        "@semantic-release/github": "^12.0.10",
        "@semantic-release/npm": "^13.2.0",
        "@size-limit/file": "^14.3.0",
        "@tailwindcss/postcss": "^4.3.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "@vitest/coverage-v8": "^5.0.4",
        "dotenv": "^18.0.8",
        "eslint": "^9.39.5",
        "eslint-config-next": "^16.2.10",
        "jsdom": "^30.1.3",
        "knip": "^6.41.0",
        "semantic-release": "^25.0.9",
        "size-limit": "^14.3.0",
        "supabase": "^2.121.0",
        "tailwindcss": "^4.3.2",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3",
        "vitest": "^5.0.4"
    },
    "packageManager": "pnpm@12.14.0",
    "engines": {
        "node": "24.22.0",
        "pnpm": ">=12.14.0"
    }
}
